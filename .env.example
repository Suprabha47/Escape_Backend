# ── AI Provider (Choose ONE) ──────────────────────────────────
# Option 1: Google Gemini (FREE via https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: Groq (FREE via https://console.groq.com/)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: Azure OpenAI
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano

# Supabase — use the service role key (never the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS — comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Production: add your Render/Vercel/Netlify frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_ENV=development
